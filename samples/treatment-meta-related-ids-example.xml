            <object-id object-id-type="zenodo-treatment-doi">10.5281/zenodo.7119827</object-id>
            <person-group person-group-type="author"><string-name><surname>Polhemus</surname>, <given-names>Dan A.</given-names></string-name></person-group>
            (<year>2022</year>)
            <article-title>Two new genera and six new species of Terrestrial Hydrometridae (Hemiptera: Heteroptera) from French Polynesia</article-title>.
